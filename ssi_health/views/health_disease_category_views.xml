<odoo>
    <record id="health_disease_category_view_search" model="ir.ui.view">
        <field name="name">health.disease_category - search</field>
        <field name="model">health.disease_category</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='code']" position="after">
                    <field name="parent_id" />
                    <group name="group_by">
                        <filter
                            name="grp_parent_id"
                            string="Parent Category"
                            context="{'group_by':'parent_id'}"
                        />
                    </group>
                </xpath>
            </data>
        </field>
    </record>

    <record id="health_disease_category_view_tree" model="ir.ui.view">
        <field name="name">health.disease_category - tree</field>
        <field name="model">health.disease_category</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='active']" position="after">
                    <field name="parent_id" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="health_disease_category_view_form" model="ir.ui.view">
        <field name="name">health.disease_category - form</field>
        <field name="model">health.disease_category</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='active']" position="after">
                    <field name="parent_id" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="health_disease_category_action" model="ir.actions.act_window">
        <field name="name">Disease Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">health.disease_category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="health_disease_category_menu"
        name="Disease Categories"
        parent="menu_health_configuration"
        action="health_disease_category_action"
        groups="health_disease_category_group"
        sequence="10"
    />
</odoo>
