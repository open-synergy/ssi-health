<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.health.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="10" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    name="body_measurement"
                    string="Body Measurements"
                    attrs="{'invisible': [('is_company', '=', True)]}"
                >
                    <separator name="height" string="Height" />
                    <field
                        name="height_ids"
                        nolabel="1"
                        colspan="4"
                        context="{'default_partner_id': active_id}"
                    >
                        <tree editable="bottom">
                            <field name="date" />
                            <field name="value" />
                        </tree>
                    </field>
                    <separator name="weight" string="Weight" />
                    <field
                        name="weight_ids"
                        nolabel="1"
                        colspan="4"
                        context="{'default_partner_id': active_id}"
                    >
                        <tree editable="bottom">
                            <field name="date" />
                            <field name="value" />
                        </tree>
                    </field>
                    <separator name="head_circumference" string="Head Circumference" />
                    <field
                        name="head_circumference_ids"
                        nolabel="1"
                        colspan="4"
                        context="{'default_partner_id': active_id}"
                    >
                        <tree editable="bottom">
                            <field name="date" />
                            <field name="value" />
                        </tree>
                    </field>
                    <separator name="allergy" string="Allergies" />
                    <field
                        name="allergy_ids"
                        nolabel="1"
                        colspan="4"
                        context="{'default_partner_id': active_id}"
                    >
                        <tree editable="bottom">
                            <field name="allergen_id" />
                            <field name="severity" />
                            <field name="reaction_ids" widget="many2many_tags" />
                            <field name="note" />
                        </tree>
                    </field>
                    <separator name="disease_history" string="Disease History" />
                    <field
                        name="disease_history_ids"
                        nolabel="1"
                        colspan="4"
                        context="{'default_partner_id': active_id}"
                    >
                        <tree editable="bottom">
                            <field name="disease_id" />
                            <field name="date_diagnosed" />
                            <field name="date_recovered" />
                            <field name="note" />
                        </tree>
                    </field>
                    <separator name="medication" string="Medications" />
                    <field
                        name="medication_ids"
                        nolabel="1"
                        colspan="4"
                        context="{'default_partner_id': active_id}"
                    >
                        <tree editable="bottom">
                            <field name="medication_id" />
                            <field name="dose" />
                            <field name="frequency" />
                            <field name="route" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="is_ongoing" />
                            <field name="disease_history_id" optional="hide" />
                            <field name="instruction" />
                        </tree>
                    </field>
                    <group name="health_provider_summary" colspan="4">
                        <field name="family_doctor_id" readonly="1" />
                        <field name="health_facility_id" readonly="1" />
                    </group>
                    <separator name="health_provider" string="Health Providers" />
                    <field
                        name="health_provider_ids"
                        nolabel="1"
                        colspan="4"
                        context="{'default_partner_id': active_id}"
                    >
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field
                                name="provider_id"
                                domain="['|', ('category_id', 'child_of', %(ssi_health.res_partner_category_health_practitioner)d), ('category_id', 'child_of', %(ssi_health.res_partner_category_health_facility)d)]"
                            />
                            <field name="role_id" />
                            <field name="date_start" />
                            <field name="note" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
